# Copy to .env (never commit .env) or set these in Colab's Secrets panel.

# Required by NCBI for PubMed requests.
NCBI_EMAIL=

# Optional: raises the PubMed rate limit from 3 to 10 requests per second.
# Create one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Required from Week 2 Day 3: Gemini API key from Google AI Studio.
# In Colab, add it under Secrets with this exact name.
GOOGLE_API_KEY=

# Gemini model ID used for extraction (the Day 3 notebook lists the ones your key can use).
GEMINI_MODEL=
